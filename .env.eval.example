# Copy to .env.eval (gitignored) and adjust for your local LLM server.
# Loaded automatically by the Makefile via `include .env.eval`.
# Used by: make eval-probe, make eval-live-baseline, make eval-live-retrieval,
# make eval-live-compare.

# Base URL of the OpenAI-compatible endpoint serving the reference model.
# Reference endpoint: Qwen3.6-27B-FP8 on an H100 (SGLang, OpenAI-compatible).
REVIEWBOT_EVAL_BASE_URL=https://mptw39pfyhq6gc-8000.proxy.runpod.net/v1

# Reference model name as the server exposes it. Must match /v1/models exactly.
REVIEWBOT_EVAL_MODEL_NAME=Qwen/Qwen3.6-27B-FP8

# API key value sent to the OpenAI client. The reference endpoint does not
# authenticate, but the SDK requires a non-empty value.
REVIEWBOT_EVAL_OPENAI_API_KEY=runpod

# Model context window we tell the worker we have available. Pick something at
# or under your model's true limit. The reference endpoint reports
# max_model_len=128000; 122880 leaves headroom for the chat template.
REVIEWBOT_EVAL_CONTEXT_TOKENS=122880

# --- Previous LAN reference (LM Studio, qwen/qwen3.6-27b, 72K window) ---
# REVIEWBOT_EVAL_BASE_URL=http://192.168.2.167:1234/v1
# REVIEWBOT_EVAL_MODEL_NAME=qwen/qwen3.6-27b
# REVIEWBOT_EVAL_OPENAI_API_KEY=ollama
# REVIEWBOT_EVAL_CONTEXT_TOKENS=65536
